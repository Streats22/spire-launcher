{
  "name": "spire-launcher",
  "productName": "Spire",
  "version": "0.1.0",
  "private": true,
  "description": "Spire Launcher — cross-platform Hytale instance launcher. Prism-style profiles, mods & worlds, local-first. Does not redistribute the game.",
  "author": "streats1 <70856472+Streats22@users.noreply.github.com>",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/patch-dev-electron-name.mjs && electron-vite dev -- --class=Spire",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/patch-dev-electron-name.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "generate:installer-assets": "python3 scripts/generate-installer-assets.py",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "build": {
    "appId": "dev.spire.launcher",
    "productName": "Spire",
    "icon": "resources/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon-dock.png",
        "to": "icon-dock.png"
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.games",
      "executableName": "Spire",
      "extendInfo": {
        "CFBundleName": "Spire",
        "CFBundleDisplayName": "Spire",
        "CFBundleIdentifier": "dev.spire.launcher"
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Install Spire",
      "background": "resources/dmg-background.png",
      "icon": "resources/icon.icns",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 180,
          "y": 220,
          "type": "file"
        },
        {
          "x": 480,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "executableName": "Spire",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spire",
      "uninstallDisplayName": "Spire",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeader": "resources/installerHeader.bmp",
      "installerSidebar": "resources/installerSidebar.bmp",
      "uninstallerSidebar": "resources/installerSidebar.bmp",
      "include": "installer.nsh",
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "executableName": "Spire",
      "maintainer": "streats1 <70856472+Streats22@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "Spire",
          "StartupWMClass": "Spire"
        }
      },
      "category": "Game",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "dompurify": "^3.4.12",
    "fflate": "^0.8.3",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
